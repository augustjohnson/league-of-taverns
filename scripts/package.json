{
  "name": "@league-of-taverns/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The I/O edge: read and validate repo files, snapshot Open5e, and draft and package character art.",
  "exports": {
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "snapshot": "tsx src/snapshot.ts",
    "validate": "tsx src/validate.ts",
    "draft-images": "tsx src/draft-images.ts",
    "package-characters": "tsx src/package-characters.ts"
  },
  "dependencies": {
    "@league-of-taverns/bots": "workspace:*",
    "@league-of-taverns/engine": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
